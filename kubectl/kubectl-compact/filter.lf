#!/usr/bin/env lowfat-filter
# kubectl-compact — compact kubectl/k output for LLM contexts.
# env: $sub $level $exit $args
# Rules run top to bottom. The first rule whose fields all hold wins.

# `truncate-json` — shared with terraform-compact.
include ../../lib/json.lf

# managedFields and its 6 child keys — the biggest noise block in YAML output.
define drop-managed-fields-yaml:
    drop /(managedFields:|  - manager:|    operation:|    time:|    apiVersion:|    fieldsType:|    fieldsV1:)/

# `describe` uses capitalized labels with different indentation.
define drop-managed-fields-desc:
    drop /(Managed Fields:|  Manager:|    Operation:|    Time:|    API Version:|    Fields Type:)/
    drop /^\s+Fields Type:/
    drop /^\s+f:[a-zA-Z]/

# Verbose but rarely needed container/image details.
define drop-describe-noise:
    drop /^\s+Image ID:\s+.+@sha256:/
    drop /^\s+Container ID:\s+containerd:\/\//
    drop /^\s+TokenExpirationSeconds:/
    drop /^\s+ConfigMapOptional:/
    drop /^\s+DownwardAPI:/

# `get` YAML at each level. Macros cannot hold a `match`, so each level
# gets its own macro and the rules below pick one.
define compact-yaml-ultra:
    drop-managed-fields-yaml
    drop /^\s*$/
    head 30

define compact-yaml-lite:
    drop-managed-fields-yaml
    head 200

define compact-yaml:
    drop-managed-fields-yaml
    drop /kubectl\.kubernetes\.io\/last-applied-configuration/
    drop /^\s*f:[a-zA-Z]/
    head 80

# ── any subcommand ────────────────────────────────────────────────
# A failed command keeps its full error output.
rule failed:
    exit: failed
    do: raw

# AST-aware truncation: valid JSON in, valid JSON out.
rule json:
    flag: -o|--output json
    do: truncate-json

# ── get ───────────────────────────────────────────────────────────
rule get-yaml:
    sub: get
    flag: -o|--output yaml
    do:
        match level:
            ultra: compact-yaml-ultra
            lite:  compact-yaml-lite
            else:  compact-yaml

# Any other explicit format (`jsonpath`, `name`, `wide`, …) is headed for a
# downstream parser and must stay byte-exact.
rule formatted:
    flag: -o|--output
    do: raw

# No `-o`: same pruning as YAML.
rule get:
    sub: get
    do:
        match level:
            ultra: compact-yaml-ultra
            lite:  compact-yaml-lite
            else:  compact-yaml

# ── describe ──────────────────────────────────────────────────────
rule describe:
    sub: describe
    do:
        match level:
            ultra:
                keep /^(Name:|Namespace:|Labels:|Status:|Type |Node:|IP:|Events:|  Type|  ----|  Normal|  Warning|Conditions:|Ready|Replicas:)/
                head 40
            lite:
                drop-managed-fields-desc
                drop-describe-noise
                head 300
            else:
                drop-managed-fields-desc
                drop-describe-noise
                drop /kubectl\.kubernetes\.io\/last-applied-configuration/
                head 150

# ── apply / delete ────────────────────────────────────────────────
rule apply:
    sub: apply
    do:
        match level:
            ultra:
                keep /(configured|created|unchanged|error|warning)/
                head 20
            lite:
                head 80
            else:
                head 40

rule delete:
    sub: delete
    do:
        match level:
            ultra:
                keep /(deleted|error|warning|not found)/
                head 15
            lite:
                head 60
            else:
                head 30

# ── logs (always tail) ────────────────────────────────────────────
rule logs:
    sub: logs
    do:
        match level:
            ultra: tail 50
            lite:  tail 200
            else:  tail 100

# ── events ────────────────────────────────────────────────────────
rule events:
    sub: events
    do:
        match level:
            ultra:
                keep /(Warning|Error|LAST SEEN|TYPE)/
                head 25
            lite:
                head 100
            else:
                head 50

# ── default ───────────────────────────────────────────────────────
rule other:
    do: head 40
