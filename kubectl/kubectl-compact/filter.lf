#!/usr/bin/env lowfat-filter
# kubectl-compact — compact kubectl/k output for LLM contexts.
# env: $sub $level $exit $args
# Every rule passes raw output straight through on a non-zero exit.

# managedFields and its 6 child keys — the biggest noise block in YAML output.
define drop-managed-fields-yaml:
    drop /(managedFields:|  - manager:|    operation:|    time:|    apiVersion:|    fieldsType:|    fieldsV1:)/

# `describe` uses capitalized labels with different indentation.
define drop-managed-fields-desc:
    drop /(Managed Fields:|  Manager:|    Operation:|    Time:|    API Version:|    Fields Type:)/
    drop /^\s+Fields Type:/
    drop /^\s+f:[a-zA-Z]/

# Verbose but rarely needed container/image details.
define drop-describe-noise:
    drop /^\s+Image ID:\s+.+@sha256:/
    drop /^\s+Container ID:\s+containerd:\/\//
    drop /^\s+TokenExpirationSeconds:/
    drop /^\s+ConfigMapOptional:/
    drop /^\s+DownwardAPI:/

# AST-aware JSON truncation — parse, prune arrays/objects, re-serialize.
# Guarantees output is always valid JSON. Falls back to raw on parse error.
define truncate-json:
    python: |
        import sys, json, os

        def truncate_node(node, max_items, depth=0, max_depth=4):
            if depth > max_depth:
                if isinstance(node, dict):
                    return {"__truncated__": f"{len(node)} keys"}
                if isinstance(node, list):
                    return [f"... {len(node)} items omitted ..."]
                return node
            if isinstance(node, list):
                if len(node) <= max_items:
                    return [truncate_node(v, max_items, depth+1, max_depth) for v in node]
                kept = max_items // 2
                head = [truncate_node(v, max_items, depth+1, max_depth) for v in node[:kept]]
                tail = [truncate_node(v, max_items, depth+1, max_depth) for v in node[-kept:]]
                return head + [f"... {len(node) - kept*2} items omitted ..."] + tail
            if isinstance(node, dict):
                if len(node) <= max_items:
                    return {k: truncate_node(v, max_items, depth+1, max_depth) for k, v in node.items()}
                keys = list(node.keys())
                kept = max_items // 2
                out = {}
                for k in keys[:kept]:
                    out[k] = truncate_node(node[k], max_items, depth+1, max_depth)
                out["__omitted__"] = f"... {len(keys) - kept*2} keys omitted ..."
                for k in keys[-kept:]:
                    out[k] = truncate_node(node[k], max_items, depth+1, max_depth)
                return out
            return node

        level = os.environ.get("level", "")
        max_items = {"ultra": 3, "lite": 20}.get(level, 8)

        raw = sys.stdin.read()
        try:
            data = json.loads(raw)
            pruned = truncate_node(data, max_items)
            out = json.dumps(pruned, indent=2, ensure_ascii=False)
            json.loads(out)
            print(out)
        except (json.JSONDecodeError, ValueError):
            print(raw, end="")

# ── get ───────────────────────────────────────────────────────────
# `-o json` → AST-aware truncation. `jsonpath`/unknown `-o` → raw for
# downstream parsers. `-o yaml` or no `-o` → prune managedFields.
get:
    if exit failed:
        raw
    elif -o json:
        truncate-json
    elif --output json:
        truncate-json
    elif -o jsonpath:
        raw
    elif --output jsonpath:
        raw
    elif -o yaml:
        match level:
            ultra:
                drop-managed-fields-yaml
                drop /^\s*$/
                head 30
            lite:
                drop-managed-fields-yaml
                head 200
            else:
                drop-managed-fields-yaml
                drop /kubectl\.kubernetes\.io\/last-applied-configuration/
                drop /^\s*f:[a-zA-Z]/
                head 80
    elif --output yaml:
        match level:
            ultra:
                drop-managed-fields-yaml
                drop /^\s*$/
                head 30
            lite:
                drop-managed-fields-yaml
                head 200
            else:
                drop-managed-fields-yaml
                drop /kubectl\.kubernetes\.io\/last-applied-configuration/
                drop /^\s*f:[a-zA-Z]/
                head 80
    elif -o:
        raw
    elif --output:
        raw
    else:
        match level:
            ultra:
                drop-managed-fields-yaml
                drop /^\s*$/
                head 30
            lite:
                drop-managed-fields-yaml
                head 200
            else:
                drop-managed-fields-yaml
                drop /kubectl\.kubernetes\.io\/last-applied-configuration/
                drop /^\s*f:[a-zA-Z]/
                head 80

# ── describe ──────────────────────────────────────────────────────
describe:
    if exit failed:
        raw
    elif -o json:
        truncate-json
    elif --output json:
        truncate-json
    elif -o:
        raw
    elif --output:
        raw
    else:
        match level:
            ultra:
                keep /^(Name:|Namespace:|Labels:|Status:|Type |Node:|IP:|Events:|  Type|  ----|  Normal|  Warning|Conditions:|Ready|Replicas:)/
                head 40
            lite:
                drop-managed-fields-desc
                drop-describe-noise
                head 300
            else:
                drop-managed-fields-desc
                drop-describe-noise
                drop /kubectl\.kubernetes\.io\/last-applied-configuration/
                head 150

# ── apply / delete ────────────────────────────────────────────────
apply:
    if exit failed:
        raw
    else:
        match level:
            ultra:
                keep /(configured|created|unchanged|error|warning)/
                head 20
            lite:
                head 80
            else:
                head 40

delete:
    if exit failed:
        raw
    else:
        match level:
            ultra:
                keep /(deleted|error|warning|not found)/
                head 15
            lite:
                head 60
            else:
                head 30

# ── logs (always tail) ────────────────────────────────────────────
logs:
    if exit failed:
        raw
    else:
        match level:
            ultra: tail 50
            lite:  tail 200
            else:  tail 100

# ── events ────────────────────────────────────────────────────────
events:
    if exit failed:
        raw
    else:
        match level:
            ultra:
                keep /(Warning|Error|LAST SEEN|TYPE)/
                head 25
            lite:
                head 100
            else:
                head 50

# ── default ───────────────────────────────────────────────────────
*:
    if exit failed:  raw
    elif -o json:    truncate-json
    elif --output json: truncate-json
    elif -o:         raw
    elif --output:   raw
    else:            head 40
