#!/usr/bin/env lowfat-filter
# cargo-compact — compact cargo output for LLM contexts.
# env: $sub $level $exit $args
# Every rule passes raw output straight through on a non-zero exit unless
# we can do better — compile errors must reach the agent intact.

# ── shared helpers ────────────────────────────────────────────────
# The big noise sources: per-crate Compiling/Downloading chatter,
# the final Finished line, and the indent-only continuation lines under
# warnings ("    |", "   --> path:line:col").
define strip-compile:
    drop /^   Compiling /
    drop /^    Updating /
    drop /^   Downloading /
    drop /^  Downloaded /
    drop /^    Finished /
    drop /^     Running /
    drop /^    Blocking /
    drop /^    Checking /

define strip-warn-meta:
    drop /^   --> /
    drop /^    = note:/

# ── failed commands ───────────────────────────────────────────────
rule test-failed:
    sub: test
    exit: failed
    do:
        strip-compile
        keep /(test result:|FAILED|failures:|---- |running |^test .+ \.\.\. (ok|FAILED|ignored)|panicked at|thread .+ panicked)/
        head 250

# Every other failed command keeps its full error output.
rule failed:
    exit: failed
    do: raw

# ── build / check ─────────────────────────────────────────────────
rule build:
    sub: build|check
    do:
        match level:
            ultra:
                strip-compile
                keep /(warning:|error|note: |help:)/
                head 40
                or "cargo $sub: ok"
            lite:  head 250
            else:
                strip-compile
                head 80

# ── clippy ────────────────────────────────────────────────────────
rule clippy:
    sub: clippy
    do:
        match level:
            ultra:
                strip-compile
                keep /(warning:|error|help:|^   = note:)/
                head 40
                or "cargo clippy: ok"
            lite:  head 300
            else:
                strip-compile
                head 100

# ── test ──────────────────────────────────────────────────────────
rule test:
    sub: test
    do:
        match level:
            ultra:
                keep /(test result:|FAILED|^test .+ \.\.\. (ok|FAILED))/
                head 40
                or "cargo test: ok"
            lite:
                strip-compile
                head 300
            else:
                strip-compile
                head 150

# ── run / doc ─────────────────────────────────────────────────────
rule run:
    sub: run|doc
    do:
        match level:
            ultra:
                strip-compile
                head 30
            lite:  head 250
            else:
                strip-compile
                head 100

# ── update ────────────────────────────────────────────────────────
rule update:
    sub: update
    do:
        match level:
            ultra:
                keep /(Updating |Adding |Removing |Locking|note:)/
                head 20
                or "cargo update: ok"
            else:  head 60

# ── fmt ───────────────────────────────────────────────────────────
rule fmt:
    sub: fmt
    do: head 40

# ── install / publish / bench ─────────────────────────────────────
rule install:
    sub: install|publish|bench
    do:
        match level:
            ultra:
                strip-compile
                head 25
            else:
                strip-compile
                head 80

# ── default ───────────────────────────────────────────────────────
rule other:
    do: head 40
