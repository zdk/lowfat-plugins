#!/usr/bin/env lowfat-filter
# pytest-compact — compact pytest output for LLM contexts.
# env: $sub $level $exit $args
# pytest has no subcommands (positional args are test paths/expressions),
# so everything routes through the catch-all.

# ── failed commands ───────────────────────────────────────────────
rule failed:
    exit: failed
    do:
        keep /(FAILED|ERROR|====|^E |^_+ .+_+$|^>   |passed|failed|short test summary|collected )/
        head 300

# ── default (only) ────────────────────────────────────────────────
rule ultra:
    level: ultra
    do:
        keep /(passed|failed|skipped|PASSED|FAILED|====|short test summary|collected )/
        head 40
        or "pytest: ok"

rule lite:
    level: lite
    do: head 300

rule default:
    do:
        drop /^platform .+ -- Python/
        drop /^rootdir:/
        drop /^plugins:/
        drop /^cachedir:/
        drop /^configfile:/
        drop /^tests\/.+\.py [\.sxXF]+\s+\[/
        drop /^={10,}$/
        head 150
