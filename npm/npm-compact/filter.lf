#!/usr/bin/env lowfat-filter
# npm-compact — compact npm output for LLM contexts.
# env: $sub $level $exit $args

# Deprecation notices are common, not actionable, and balloon install output.
define strip-deprecation:
    drop /^npm warn deprecated /
    drop /^npm WARN deprecated /

# ── failed commands ───────────────────────────────────────────────
rule audit-failed:
    sub: audit
    exit: failed
    do:
        keep /(severity|vulnerabilities|^# npm|^to address|^npm audit|^[0-9]+ vulnerabilities)/
        head 200

# Every other failed command keeps its full error output.
rule failed:
    exit: failed
    do: raw

# ── install / i / ci ──────────────────────────────────────────────
rule install:
    sub: install|i|ci
    do:
        match level:
            ultra:
                keep /(added|removed|changed|audited|vulnerabilities|funding)/
                head 15
                or "npm $sub: ok"
            lite:
                strip-deprecation
                head 150
            else:
                strip-deprecation
                head 50

# ── list / ls ─────────────────────────────────────────────────────
rule list:
    sub: list|ls
    do:
        match level:
            ultra: head 30
            lite:  head 250
            else:  head 100

# ── audit ─────────────────────────────────────────────────────────
rule audit:
    sub: audit
    do:
        match level:
            ultra:
                keep /(severity|vulnerabilities|^# npm|^to address|^[0-9]+ vulnerabilities)/
                head 30
                or "npm audit: ok"
            else:  head 80

# ── outdated ──────────────────────────────────────────────────────
rule outdated:
    sub: outdated
    do:
        match level:
            ultra: head 30
            lite:  head 200
            else:  head 80

# ── run / test ────────────────────────────────────────────────────
# These pass through to user scripts; we cap by level but can't filter
# semantically without knowing what the script does.
rule run:
    sub: run|test
    do:
        match level:
            ultra: head 60
            lite:  head 300
            else:  head 150

# ── update ────────────────────────────────────────────────────────
rule update:
    sub: update
    do:
        match level:
            ultra:
                keep /(added|removed|changed|up to date)/
                head 15
                or "npm update: ok"
            else:  head 60

# ── default ───────────────────────────────────────────────────────
rule other:
    do: head 40
