#!/usr/bin/env lowfat-filter
# aws-compact — compact AWS CLI output for LLM contexts.
# env: $sub $level $exit $args
# $sub is the service name (ec2, s3, iam, ...). The action verb
# (describe-instances, list-buckets) is the next argument — we don't
# split on it here because filter strategy is the same across actions
# within a service: JSON describe-* output is what blows up token budget.

# JSON-specific noise: pure structural lines with no data and empty
# collections that AWS emits for almost every resource ("Groups": [],
# "ProductCodes": [], "Ipv6Addresses": [], ...).
define strip-json-frame:
    drop /^\s*[\{\}\[\],]\s*$/

define strip-empty-collections:
    drop /^\s+"[A-Za-z]+": \[\],?$/
    drop /^\s+"[A-Za-z]+": \{\},?$/
    drop /^\s+"[A-Za-z]+": "",?$/

# ── failed commands ───────────────────────────────────────────────
# A failed command keeps its full error output.
rule failed:
    exit: failed
    do: raw

# ── ec2 / rds / lambda / ecs / eks / cloudformation (verbose JSON) ──
rule ec2:
    sub: ec2|rds|lambda|ecs|eks|cloudformation|elbv2|elasticache
    do:
        match level:
            ultra:
                strip-json-frame
                strip-empty-collections
                head 40
            lite:
                strip-empty-collections
                head 500
            else:
                strip-json-frame
                strip-empty-collections
                head 80

# ── iam (huge with attached policies) ─────────────────────────────
rule iam:
    sub: iam
    do:
        match level:
            ultra:
                keep /("(UserName|RoleName|PolicyName|Arn|CreateDate)":)/
                head 60
            lite:
                strip-empty-collections
                head 500
            else:
                strip-json-frame
                strip-empty-collections
                head 100

# ── s3 (file listings) ────────────────────────────────────────────
rule s3:
    sub: s3
    do:
        match level:
            ultra: head 30
            lite:  head 500
            else:  head 100

# ── logs (get-log-events: timestamps + messages) ──────────────────
rule logs:
    sub: logs
    do:
        match level:
            ultra: head 40
            lite:  head 500
            else:  head 100

# ── dynamodb (type-annotated values inflate output) ───────────────
rule dynamodb:
    sub: dynamodb
    do:
        match level:
            ultra:
                strip-json-frame
                strip-empty-collections
                head 40
            lite:
                strip-empty-collections
                head 500
            else:
                strip-json-frame
                strip-empty-collections
                head 100

# ── sts / sqs / sns / ssm (smaller responses) ─────────────────────
rule sts:
    sub: sts|sqs|sns|ssm
    do:
        match level:
            ultra: head 25
            lite:  head 300
            else:  head 60

# ── default ───────────────────────────────────────────────────────
rule other:
    do:
        match level:
            ultra: head 40
            lite:  head 400
            else:
                strip-empty-collections
                head 80
