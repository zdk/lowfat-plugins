#!/usr/bin/env lowfat-filter
# go-compact — compact go output for LLM contexts.
# env: $sub $level $exit $args

# ── failed commands ───────────────────────────────────────────────
rule test-failed:
    sub: test
    exit: failed
    do:
        keep /(^=== RUN|^--- FAIL|^--- PASS|^FAIL|^ok\b|^PASS\b|panic:|^\s+.+_test\.go:|Error:|--- SKIP)/
        head 300

# Every other failed command keeps its full error output.
rule failed:
    exit: failed
    do: raw

# ── test ──────────────────────────────────────────────────────────
rule test:
    sub: test
    do:
        match level:
            ultra:
                keep /(^--- (FAIL|PASS)|^FAIL|^ok\b|^PASS\b)/
                head 50
                or "go test: ok"
            lite:  head 300
            else:
                drop /^=== (RUN|PAUSE|CONT)/
                head 150

# ── build / vet ───────────────────────────────────────────────────
rule build:
    sub: build|vet
    do:
        match level:
            ultra:
                head 30
                or "go $sub: ok"
            else:  head 100

# ── mod ───────────────────────────────────────────────────────────
rule mod:
    sub: mod
    do:
        match level:
            ultra:
                head 30
                or "go mod: ok"
            else:  head 100

# ── get / install ─────────────────────────────────────────────────
rule get:
    sub: get|install
    do:
        match level:
            ultra:
                keep /(go: (downloading|added|removed|upgraded)|Error)/
                head 25
                or "go $sub: ok"
            else:  head 80

# ── run ───────────────────────────────────────────────────────────
rule run:
    sub: run
    do:
        match level:
            ultra: head 40
            lite:  head 300
            else:  head 150

# ── fmt ───────────────────────────────────────────────────────────
rule fmt:
    sub: fmt
    do: head 40

# ── default ───────────────────────────────────────────────────────
rule other:
    do: head 40
