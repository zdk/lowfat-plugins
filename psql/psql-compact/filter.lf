#!/usr/bin/env lowfat-filter
# psql-compact — compact psql output for LLM contexts.
# env: $sub $level $exit $args

# Connection / setup banner emitted at session start; rarely useful.
define strip-banner:
    drop /^psql \(\d/
    drop /^Type "help" for help/
    drop /^SSL connection /
    drop /^You are connected to /

# NOTICE/INFO lines (functions raising RAISE NOTICE, etc.) are usually noise.
define strip-notices:
    drop /^NOTICE: /
    drop /^INFO: /
    drop /^DEBUG: /

# ── failed commands ───────────────────────────────────────────────
rule failed:
    exit: failed
    do:
        strip-banner
        head 200

# ── default (only) ────────────────────────────────────────────────
rule ultra:
    level: ultra
    do:
        strip-banner
        strip-notices
        head 40

rule lite:
    level: lite
    do:
        strip-banner
        head 300

rule default:
    do:
        strip-banner
        strip-notices
        head 120
